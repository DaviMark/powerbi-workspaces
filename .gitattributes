# Normaliza finais de linha (PBIP/TMDL são texto; diffs limpos entre Windows e Mac/Linux)
* text=auto eol=lf
*.tmdl   text eol=lf diff
*.json   text eol=lf
*.pbir   text eol=lf
*.pbism  text eol=lf
*.pbip   text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.ps1    text eol=crlf

# Binários
*.pbit   binary
*.pbiviz binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.pdf    binary
*.pptx   binary
*.xlsx   binary
*.ttf    binary
*.woff2  binary

