/// Dimensão calendário (DAX, sem Power Query). Período = anos cobertos pelos vencimentos da fato.
/// Marcada como tabela de datas. Auto date/time está desligado no modelo.
table Calendario
	dataCategory: Time

	column Data
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Data]

	column Ano
		dataType: int64
		formatString: 0
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Ano]

	column 'Mês Nº'
		dataType: int64
		formatString: 0
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Mês Nº]

	column 'Mês'
		dataType: string
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Mês]
		sortByColumn: 'Mês Nº'

	column 'Ano-Mês'
		dataType: string
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Ano-Mês]

	column Trimestre
		dataType: string
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Trimestre]

	column 'Dia da Semana Nº'
		dataType: int64
		formatString: 0
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Dia da Semana Nº]

	column 'Dia da Semana'
		dataType: string
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Dia da Semana]
		sortByColumn: 'Dia da Semana Nº'

	partition Calendario = calculated
		mode: import
		source =
				VAR _inicio = DATE ( YEAR ( COALESCE ( MIN ( 'Fato Titulos'[Data Vencimento] ), TODAY () ) ), 1, 1 )
				VAR _fim = DATE ( YEAR ( COALESCE ( MAX ( 'Fato Titulos'[Data Vencimento] ), TODAY () ) ), 12, 31 )
				RETURN
				    ADDCOLUMNS (
				        SELECTCOLUMNS ( CALENDAR ( _inicio, _fim ), "Data", [Date] ),
				        "Ano", YEAR ( [Data] ),
				        "Mês Nº", MONTH ( [Data] ),
				        "Mês", FORMAT ( [Data], "mmm" ),
				        "Ano-Mês", FORMAT ( [Data], "yyyy-mm" ),
				        "Trimestre", "T" & QUARTER ( [Data] ),
				        "Dia da Semana Nº", WEEKDAY ( [Data], 2 ),
				        "Dia da Semana", FORMAT ( [Data], "ddd" )
				    )
