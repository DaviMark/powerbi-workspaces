/// Tabela de medidas do modelo. Nenhuma coluna visível: só medidas, organizadas em pastas.
/// A coluna oculta [Data Carga] registra o momento do último refresh (UTC-3h).
table _Medidas

	/// Valor ainda não recebido (parcela − pago), títulos cancelados excluídos.
	measure 'Saldo em Aberto' = SUM ( 'Fato Titulos'[Saldo Aberto] )
		formatString: \R\$ #,0
		displayFolder: Valores

	/// Saldo em aberto com vencimento anterior à data da carga.
	measure 'Valor Vencido' = CALCULATE ( [Saldo em Aberto], 'Fato Titulos'[Dias Atraso] > 0 )
		formatString: \R\$ #,0
		displayFolder: Valores

	/// Saldo em aberto com vencimento hoje ou no futuro.
	measure 'Valor a Vencer' = CALCULATE ( [Saldo em Aberto], 'Fato Titulos'[Dias Atraso] <= 0, ISBLANK ( 'Fato Titulos'[Data Pagamento] ) )
		formatString: \R\$ #,0
		displayFolder: Valores

	/// Participação do valor vencido no saldo em aberto.
	measure '% Vencido' = DIVIDE ( [Valor Vencido], [Saldo em Aberto] )
		formatString: 0.0%
		displayFolder: Indicadores

	/// Média de dias de atraso ponderada pelo saldo vencido.
	measure 'Prazo Médio de Atraso (dias)' =
			DIVIDE (
			    SUMX ( FILTER ( 'Fato Titulos', 'Fato Titulos'[Dias Atraso] > 0 ), 'Fato Titulos'[Saldo Aberto] * 'Fato Titulos'[Dias Atraso] ),
			    [Valor Vencido]
			)
		formatString: 0
		displayFolder: Indicadores

	/// Clientes com pelo menos uma parcela vencida em aberto.
	measure 'Clientes Inadimplentes' = CALCULATE ( DISTINCTCOUNT ( 'Fato Titulos'[id_cliente] ), 'Fato Titulos'[Dias Atraso] > 0 )
		formatString: #,0
		displayFolder: Contagens

	/// Quantidade de parcelas ainda não pagas.
	measure 'Parcelas em Aberto' = CALCULATE ( COUNTROWS ( 'Fato Titulos' ), ISBLANK ( 'Fato Titulos'[Data Pagamento] ) )
		formatString: #,0
		displayFolder: Contagens

	/// Título-conclusão da página: quanto do saldo está vencido.
	measure 'Título Visão Geral' = "Vencido: " & FORMAT ( [Valor Vencido], "R$ #,0" ) & " (" & FORMAT ( [% Vencido], "0.0%" ) & " do saldo em aberto)"
		displayFolder: Textos

	/// Texto pronto para o cabeçalho das páginas: "Atualizado em dd/mm/aaaa hh:mm".
	measure 'Atualizado em' = "Atualizado em " & FORMAT ( MAX ( '_Medidas'[Data Carga] ), "dd/mm/yyyy hh:nn" )
		displayFolder: _Sistema

	column 'Data Carga'
		dataType: dateTime
		isHidden
		formatString: General Date
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Data Carga]

	partition _Medidas = calculated
		mode: import
		source = ROW ( "Data Carga", UTCNOW () + ( -3 / 24 ) )
