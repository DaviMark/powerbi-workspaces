#!/bin/sh
# Atalho: ./pbw <comando>  (macOS, Linux, Git Bash)
for c in python3 python py; do
  if command -v "$c" >/dev/null 2>&1 && "$c" -c "import sys; sys.exit(sys.version_info < (3, 11))" >/dev/null 2>&1; then
    exec "$c" "$(dirname "$0")/_sistema/pbw.py" "$@"
  fi
done
echo "Python 3.11+ não encontrado. Instale em https://www.python.org/downloads/" >&2
exit 1
